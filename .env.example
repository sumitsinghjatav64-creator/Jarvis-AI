# ── MARK LV — Autonomous AI Content Business (.env.example) ──────────────────
# Copy to .env and fill in only after obtaining official developer approvals.
# Monthly Operating Budget: ₹0 (Zero-Spend Mode is strictly enforced in code)

# Gemini Free Tier API Key (Google AI Studio)
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Local LLM Fallback (Ollama)
LLM_PROVIDER=ollama
LLM_URL=http://localhost:11434
LLM_MODEL=llama3.2

# YouTube Data API v3 (OAuth 2.0 Desktop / Web Client)
YOUTUBE_CLIENT_SECRET_FILE=config/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=config/youtube_token.json
# Set to "true" ONLY after passing Google's OAuth Verification Audit.
# While "false", uploads default to privacyStatus="private" per YouTube API policy.
YOUTUBE_PROJECT_VERIFIED=false

# Instagram Graph API (Requires IG Professional Account linked to a Facebook Page)
IG_USER_ID=your_instagram_business_account_id_here
IG_ACCESS_TOKEN=your_long_lived_ig_graph_access_token_here

# Optional Authorized Affiliate Product Feed (JSON file path)
AFFILIATE_FEED_JSON_PATH=